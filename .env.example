# ============================================================
# RKS ONE
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ─────────────────────────────────────────
# LOCAL DEVELOPMENT (docker-compose)
# ─────────────────────────────────────────

# PostgreSQL container credentials (local only)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=rks_db
POSTGRES_PORT=5432

# Local DATABASE_URL (points to the postgres docker-compose service)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# ─────────────────────────────────────────
# PRODUCTION (Render + Supabase)
# ─────────────────────────────────────────

# Supabase DATABASE_URL — copy from:
#   Supabase Dashboard → Settings → Database → Connection String → URI
#
# Use the Session pooler (port 5432, no pgbouncer=true). URL-encode special
# characters in the password (@ -> %40):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5

# ─────────────────────────────────────────
# SHARED (local + production)
# ─────────────────────────────────────────

NODE_ENV=production
PORT=5000

# JWT — use a long random secret in production
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Timezone
TZ=Asia/Kolkata

# Logging
LOG_RETENTION_DAYS=60

# ─────────────────────────────────────────
# CORS — IMPORTANT for production
# ─────────────────────────────────────────
# Browser origins of the web app (Vercel), comma-separated. localhost and private LAN
# addresses are always allowed (vite dev, Android app, shop PCs).
ALLOWED_ORIGINS=https://rksone.qenbel.site,https://app.rksone.qenbel.site

# Reverse proxies in front of the app, so rate limits and logs see the real client IP.
# Render = 1 (default). Render behind a proxied Cloudflare DNS record = 2.
TRUST_PROXY_HOPS=1

# Android APK link handed out after /api/auth/verify-download: an absolute URL
# (e.g. a GitHub Release asset) or a path on the web app's domain. Default /download.
APK_URL=

# ─────────────────────────────────────────
# LOCAL BACKUP SERVICE (docker-compose only)
# Not used in Render deployment — Supabase handles backups
# ─────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_SCHEDULE_HOUR=2
